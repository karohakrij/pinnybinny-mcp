{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PinnyBinny Flashcard Set",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "cards"],
  "properties": {
    "title":       { "type": "string", "minLength": 1, "maxLength": 200 },
    "preview":     { "type": "boolean", "default": false },
    "color_theme": { "type": "string", "enum": ["yellow", "blue", "green", "pink", "purple", "orange"], "default": "yellow" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "answer":   { "type": "string", "minLength": 1, "maxLength": 1000 },
          "color":    { "type": "string", "enum": ["white", "blue", "green", "red", "purple"], "default": "white" }
        }
      }
    }
  }
}
