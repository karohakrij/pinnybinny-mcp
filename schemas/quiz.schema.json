{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "PinnyBinny Quiz",
  "x-version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "questions"],
  "properties": {
    "title":             { "type": "string", "minLength": 1, "maxLength": 200 },
    "preview":           { "type": "boolean", "default": true },
    "preview_id":        { "type": "string" },
    "color_theme":       { "type": "string", "enum": ["yellow", "blue", "green", "pink", "purple", "orange"], "default": "yellow" },
    "time_per_question": { "type": "integer", "minimum": 5, "maximum": 120, "default": 15, "x-clamp": true },
    "questions_to_show": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10, "x-clamp": true },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answers", "correct_index"],
        "properties": {
          "question":      { "type": "string", "minLength": 1, "maxLength": 180 },
          "answers":       { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
          "correct_index": { "type": "integer", "minimum": 0, "maximum": 3 }
        }
      }
    }
  }
}
